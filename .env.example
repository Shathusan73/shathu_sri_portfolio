# WaAPI WhatsApp (preferred, server only). https://waapi.app
# Instance ID is optional — the server will use your first instance if omitted.
# Recipient is the WhatsApp number that receives inquiries (digits with country code).

WAAPI_API_TOKEN=
WAAPI_INSTANCE_ID=
WAAPI_RECIPIENT_PHONE=94701455259

# CallMeBot WhatsApp alerts (fallback, server only).
# 1. Add the CallMeBot contact on WhatsApp.
# 2. Send: I allow callmebot to send me messages
# 3. Paste the API key it replies with.

WHATSAPP_PHONE=94701455259
WHATSAPP_API_KEY=

# WhatsApp Cloud API (preferred in production, server only).
# If these three are set, they are used instead of CallMeBot.

WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_RECIPIENT_PHONE=94701455259

# Gemini (server only). Get a key at https://aistudio.google.com/apikey
# Restart `pnpm dev` after adding it.

GEMINI_API_KEY=
